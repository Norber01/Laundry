rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath(shop) { return /databases/$(database)/documents/shops/$(shop)/members/$(request.auth.uid); }
    function isMember(shop) { return signedIn() && exists(memberPath(shop)); }
    function isManager(shop) { return isMember(shop) && get(memberPath(shop)).data.role == 'manager'; }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }

    // Staff may only move an order forward: not paid -> paid, not collected -> collected.
    // They cannot change items, totals, or undo a payment.
    function staffOrderUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['paid', 'paidOn', 'paidBy', 'paidByUid', 'collected', 'collectedOn', 'collectedBy', 'collectedByUid'])
        && (!changed.hasAny(['paid']) || (resource.data.paid == false && request.resource.data.paid == true))
        && (!changed.hasAny(['collected']) || (resource.data.collected == false && request.resource.data.collected == true));
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Lookup used when an invited staff member signs in for the first time.
    match /invites/{email} {
      allow read: if signedIn() && (myEmail() == email || isManager(resource.data.shopId));
      allow create, update: if isManager(request.resource.data.shopId);
      allow delete: if signedIn() && (myEmail() == email || isManager(resource.data.shopId));
    }

    match /shops/{shop} {
      allow read: if isMember(shop);
      allow create: if signedIn() && request.auth.uid == shop && request.resource.data.ownerUid == shop;
      allow update: if isManager(shop) && request.resource.data.ownerUid == resource.data.ownerUid;

      match /members/{uid} {
        allow read: if isMember(shop) || (signedIn() && request.auth.uid == uid);
        allow create: if isManager(shop)
          // the owner creating their own manager record when setting up the shop
          || (signedIn() && request.auth.uid == uid && uid == shop && request.resource.data.role == 'manager')
          // an invited person accepting their invite, with exactly the role they were given
          || (signedIn() && request.auth.uid == uid && exists(invitePath())
              && get(invitePath()).data.shopId == shop
              && get(invitePath()).data.role == request.resource.data.role);
        // The shop owner can never be demoted or removed.
        allow update, delete: if isManager(shop) && uid != shop;
      }

      match /invites/{email} {
        allow read, write: if isManager(shop);
        allow delete: if signedIn() && myEmail() == email;
      }

      match /orders/{id} {
        allow read, create: if isMember(shop);
        allow update: if isManager(shop) || (isMember(shop) && staffOrderUpdateOk());
        allow delete: if isManager(shop);
      }

      match /expenses/{id} {
        allow read, create: if isMember(shop);
        allow update, delete: if isManager(shop);
      }
    }
  }
}
